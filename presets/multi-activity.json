{
  "id": "multi-activity",
  "label": "Multi-activity academy (skills + academics)",
  "settings": {
    "receipt_prefix": "RCPT",
    "due_day": "5"
  },
  "categories": ["Arts", "Martial Arts", "Skills", "Academics", "Foundation"],
  "courses": [
    { "category": "Arts", "name": "Drawing", "monthly_fee": null, "classes_per_week": 2 },
    { "category": "Martial Arts", "name": "Karate", "monthly_fee": null, "classes_per_week": 3 },
    { "category": "Martial Arts", "name": "Kalari", "monthly_fee": null, "classes_per_week": 3 },
    { "category": "Skills", "name": "Abacus", "monthly_fee": null, "classes_per_week": 2 },
    { "category": "Skills", "name": "Chess", "monthly_fee": null, "classes_per_week": 2 },
    { "category": "Skills", "name": "Vedic Maths", "monthly_fee": null, "classes_per_week": 2 },
    { "category": "Skills", "name": "Spoken English", "monthly_fee": null, "classes_per_week": 3 },
    { "category": "Academics", "name": "Tuitions", "monthly_fee": null, "classes_per_week": 6 },
    { "category": "Foundation", "name": "IIT Foundation", "monthly_fee": null, "classes_per_week": 3 },
    { "category": "Foundation", "name": "NEET Foundation", "monthly_fee": null, "classes_per_week": 3 }
  ],
  "feePlans": [
    { "name": "Monthly", "frequency": "Monthly", "months_covered": 1, "discount_pct": 0 },
    { "name": "Annual (10 months)", "frequency": "Annual", "months_covered": 10, "discount_pct": 15 }
  ],
  "chargeItems": [
    { "name": "Admission fee", "default_amount": "", "applies_to": "Admission" }
  ],
  "expenseCategories": ["Rent", "Marketing", "Salaries", "Procurement", "Utilities", "Gateway fees", "Other"],
  "customFields": [
    { "entity": "Student", "key": "syllabus", "label": "Syllabus", "type": "select", "options": ["SSC", "CBSE", "ICSE", "Other"], "required": false }
  ],
  "messageTemplates": [
    {
      "type": "FeeReminder",
      "name": "Monthly fee reminder",
      "text": "Dear {parent}, this is a gentle reminder that the fee of ₹{balance} for {student} ({course}, {month}) is pending. Pay securely here: {payment_link}\n\nThank you,\n{academy}"
    },
    {
      "type": "Receipt",
      "name": "Payment receipt",
      "text": "Dear {parent}, we have received ₹{amount} for {student} ({course}, {month}). Receipt no. {receipt_no}: {receipt_link}\nBalance remaining: ₹{balance}\n\nThank you,\n{academy}"
    },
    {
      "type": "Absent",
      "name": "Absent today",
      "text": "Dear {parent}, {student} was absent from {course} today ({date}). Please let us know if everything is okay.\n\n{academy}"
    },
    {
      "type": "Event",
      "name": "Event announcement",
      "text": "Dear parents, we are happy to announce {event} on {date} at {academy}. {details}"
    },
    {
      "type": "NewCourse",
      "name": "New course announcement",
      "text": "New at {academy}: {course}! {details}\nCall or WhatsApp {academy_phone} to enrol."
    }
  ]
}
